{
  "name": "campuslend",
  "version": "1.0.0",
  "private": true,
  "description": "CampusLend - Equipment Loan Platform API (Hono + Cloudflare D1)",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "migrate": "wrangler d1 migrations apply campuslend-db --local",
    "migrate:remote": "wrangler d1 migrations apply campuslend-db --remote",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "node tests/run-tests.mjs",
    "test:guide": "node tests/run-tests.mjs --guide-only --out docs/guide-results.md"
  },
  "dependencies": {
    "hono": "^4.13.13",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261006.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.147.0"
  }
}
